# Required model credentials
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Optional provider/model overrides
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Optional infrastructure overrides
MONGODB_URI=mongodb://localhost:27017/stock_agent
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
MILVUS_HOST=localhost
MILVUS_PORT=19530
PREDICTION_BASE_URL=http://localhost:8000

# Configure at least one news provider. application.example.yml uses Tavily by default.
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Required only when Feishu document synchronization is used
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
